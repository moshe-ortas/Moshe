# Gmail credentials
# Use an App Password (not your regular Gmail password)
# To create one: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: folder to save downloaded invoice PDFs (default: ./invoices)
DOWNLOAD_DIR=./invoices

# Optional: output CSV file path (default: ./pazoom_invoices.csv)
CSV_OUTPUT=./pazoom_invoices.csv
